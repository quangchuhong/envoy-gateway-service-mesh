# Copy file này thành config/demo.env rồi kiểm tra lại giá trị:
#   cp config/demo.env.example config/demo.env
# config/demo.env đã nằm trong .gitignore.

# ---- AWS / EKS
export AWS_REGION=ap-southeast-1
export EKS_CLUSTER_NAME=devops-tools          # tên cụm EKS hiện tại

# ---- Domain cho 3 app demo: portal.<DOMAIN>, api.<DOMAIN>, partner.<DOMAIN>
# Cert ACM bên dưới là wildcard *.gitlabonlinecom.click -> phủ đúng 3 hostname này
export DOMAIN=gitlabonlinecom.click
# Hosted zone Route 53 của DOMAIN. Để trống: scripts/05-dns.sh tự tìm theo tên domain.
# Tra tay: aws route53 list-hosted-zones-by-name --dns-name gitlabonlinecom.click --max-items 1
export HOSTED_ZONE_ID=

# ---- Cert public trong ACM (account 609320954321, region ap-southeast-1), domain *.gitlabonlinecom.click
# NLB sẽ terminate TLS bằng cert này (chế độ nlb-tls). Phải cùng account và cùng region với cụm EKS.
export ACM_CERT_ARN=arn:aws:acm:ap-southeast-1:609320954321:certificate/569f4470-6ac3-4ef2-be6e-7eb012397305

# ---- Subnet cho NLB (tuỳ chọn)
# Để trống: AWS Load Balancer Controller tự tìm public subnet có tag kubernetes.io/role/elb=1
#           trong VPC của cụm (01-check-prereqs.sh kiểm tra điều này).
# Điền danh sách (cách nhau dấu phẩy) khi không muốn gắn tag lên subnet, ví dụ:
#   export NLB_SUBNETS=subnet-0aaa,subnet-0bbb,subnet-0ccc   (public subnet, nên mỗi AZ một subnet)
export NLB_SUBNETS=

# ---- Cognito
# Prefix cho Hosted UI: https://<prefix>.auth.<region>.amazoncognito.com (duy nhất trong region)
export COGNITO_DOMAIN_PREFIX=gitlabonlinecom-eg-demo
export COGNITO_POOL_NAME=eg-demo-users

# ---- Phiên bản
export EG_VERSION=v1.9.3

# ---- Test (tuỳ chọn)
# Gọi thẳng tới IP của NLB khi DNS chưa lan truyền: GATEWAY_IP=<một IP của NLB>
export GATEWAY_IP=
# 1 = bỏ qua kiểm tra cert TLS (chỉ dùng khi test với cert self-signed)
export INSECURE_TLS=0
